# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채운다.
# .env는 .gitignore에 들어 있어서 GitHub에 올라가지 않는다. (토큰은 비밀번호처럼 다룰 것)

# BotFather에게 받은 봇 토큰 (예: 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=

# 알림을 받을 사람(또는 단체방)의 Chat ID, 여러 개면 쉼표로 구분
#   python telegram_setup.py 로 확인할 수 있다
TELEGRAM_CHAT_IDS=

# 알림에 표시할 침상 이름
BED_LABEL=101호 1번 침상

# 카메라: DroidCam 앱에 보이는 IP (예: 10.22.9.230), USB·웹캠이면 장치 번호 (예: 1)
CAMERA_SOURCE=
